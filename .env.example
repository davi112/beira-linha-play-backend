# Copie este arquivo para .env e ajuste as configurações.

APP_ALLOWED_HOSTS=http://localhost:5173,http://127.0.0.1:5173

# Segredo JWT em Base64
JWT_SECRET=altere-este-segredo-em-base64

GEMINI_API_KEY=

POSTGRES_DB=beira_linha_play
POSTGRES_PORT=5432
SERVER_PORT=8080

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/beira_linha_play
SPRING_DATASOURCE_USERNAME=beira
SPRING_DATASOURCE_PASSWORD=senha

APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

