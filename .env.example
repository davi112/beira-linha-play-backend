# Copie este arquivo para .env (não versionado).
# O Docker Compose lê o .env automaticamente.

APP_ALLOWED_HOSTS=http://localhost:5173

# Segredo JWT em Base64 (mínimo 256 bits). Gere com: openssl rand -base64 32
JWT_SECRET=altere-este-segredo-em-base64-com-pelo-menos-32-bytes==

# PostgreSQL (docker compose e Spring Boot local)
POSTGRES_DB=beira_linha_play
POSTGRES_PORT=5432
SERVER_PORT=8080

# Host localhost serve para `mvn spring-boot:run`.
# No Compose, a API troca o host para o serviço `postgres` automaticamente.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/beira_linha_play
SPRING_DATASOURCE_USERNAME=beira
SPRING_DATASOURCE_PASSWORD=beira

# Cookies: depende do front/API (HTTP local → false/Lax; HTTPS cross-site → true/None).
# Não tem relação com o banco ser local ou Supabase.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# --- Supabase ---
# Não use db.<ref>.supabase.co:5432 (conexão direta): no plano gratuito ela é só IPv6
# e costuma falhar com "Network is unreachable" no Windows/Docker.
# Use o Session pooler do painel (Connect → Session pooler, porta 5432).
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
# SPRING_DATASOURCE_PASSWORD=SENHA_DO_PROJETO
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
# Não use a porta 6543 (Transaction pooler): o Hibernate precisa de prepared statements.
