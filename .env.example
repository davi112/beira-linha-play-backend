# Copie este arquivo para .env e ajuste as configurações.

# Dev local (Vite): origens do front. Em Docker na VPS o nginx faz same-origin;
# use http://IP_PUBLICO (e depois https://seu-dominio).
APP_ALLOWED_HOSTS=http://localhost:5173,http://127.0.0.1:5173

# Segredo JWT em Base64 (gere um valor novo em produção).
JWT_SECRET=altere-este-segredo-em-base64

GEMINI_API_KEY=

# Token da API pública do Sympla (header s_token). Só no backend.
SYMPLA_API_KEY=

# Cloudinary (upload/exclusão de medalhas na API — não vai no frontend)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=medalhas

POSTGRES_DB=beira_linha_play
POSTGRES_PORT=5432
SERVER_PORT=8080

# Dev na máquina: localhost. Compose (API + Postgres na mesma rede):
#   jdbc:postgresql://postgres:5432/beira_linha_play
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/beira_linha_play
SPRING_DATASOURCE_USERNAME=beira
SPRING_DATASOURCE_PASSWORD=senha

# HTTP (IP na VPS): Secure=false. HTTPS (domínio): Secure=true.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Na VPS o Compose define SPRING_PROFILES_ACTIVE=prod (application-prod.yml).
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10

# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-<REGIAO>.pooler.supabase.com:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres.<PROJECT_REF>
# SPRING_DATASOURCE_PASSWORD=SENHA_DO_PROJETO
# SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=5
